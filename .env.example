# Optional Firebase (shared shop create/join). Leave empty → local-only mode.
# Do not commit real secrets. Copy to .env.local (or .env) and rebuild for create/join.
# Enable Anonymous Authentication in the Firebase console (Authentication → Sign-in method).
# Deploy in-repo firestore.rules before relying on membership enforcement (#5).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
