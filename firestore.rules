rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // #5: Firebase Anonymous Auth + shop membership.
    // Unauthenticated strangers with a guessed shopId are denied (closes open IDOR).
    // Signed-in get is allowed so join/unlock can client-verify PIN hashes, then
    // write membership via join-self update. PIN hashes remain readable to any
    // authenticated caller who knows shopId on legacy docs. cf2: the shop-server
    // functions move hashes into shopSecrets/ (denied below) and leave only
    // pinsConfigured on the shop doc. localStorage session is UI-only; rules enforce membership
    // for writes after create/join.

    function signedIn() {
      return request.auth != null;
    }

    function isValidShopId(id) {
      return id.size() > 0
        && id.size() <= 1500
        && id != '.'
        && id != '..'
        && !id.matches('.*[/].*')
        && !id.matches('__.*__');
    }

    function membersMap() {
      return resource.data.get('members', {});
    }

    function requestMembers() {
      return request.resource.data.get('members', {});
    }

    function memberRole() {
      return request.auth.uid in membersMap()
        ? membersMap()[request.auth.uid]
        : null;
    }

    function isOwner() {
      return signedIn()
        && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    function isOffice() {
      return isOwner() || memberRole() == 'office';
    }

    function isTech() {
      return memberRole() == 'tech';
    }

    function isMemberData(shop) {
      return shop != null
        && (
          shop.get('ownerUid', '') == request.auth.uid
          || (
            request.auth.uid in shop.get('members', {})
            && shop.get('members', {})[request.auth.uid] in ['office', 'tech']
          )
        );
    }

    function isShopMember(shopId) {
      let snap = get(/databases/$(database)/documents/shops/$(shopId));
      return snap != null && isMemberData(snap.data);
    }

    function ownerUidUnchanged() {
      return request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '');
    }

    function authUnchanged() {
      return request.resource.data.get('auth', null) == resource.data.get('auth', null);
    }

    function pinsConfiguredUnchanged() {
      return request.resource.data.get('pinsConfigured', null) == resource.data.get('pinsConfigured', null);
    }

    // cf2: once the shop server holds the PIN hashes, no client write may put
    // `auth` back on the readable doc or clear `pinsConfigured`.
    function pinsStayHidden() {
      return resource.data.get('pinsConfigured', false) != true
        || (
          request.resource.data.get('pinsConfigured', false) == true
          && !request.resource.data.keys().hasAny(['auth'])
        );
    }

    function membersUnchanged() {
      return requestMembers() == membersMap();
    }

    // Join / unlock after client PIN verify: only members[+optional ownerUid] and updatedAt change.
    function isJoinSelfUpdate() {
      return signedIn()
        && request.resource.data.members[request.auth.uid] in ['office', 'tech']
        && request.resource.data.members.diff(membersMap()).affectedKeys().hasOnly([request.auth.uid])
        && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'updatedAt'])
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'updatedAt', 'ownerUid'])
            && resource.data.get('ownerUid', '') == ''
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.members[request.auth.uid] == 'office'
          )
        );
    }

    // Pre-#3 / no-auth shops: first office device may set auth + claim ownership.
    // cf2: a shop whose hashes moved to the shop server (pinsConfigured) is not "no-auth".
    // Diff limited to bootstrap fields so other shop data cannot be overwritten.
    function isLegacyPinBootstrap() {
      return signedIn()
        && !resource.data.keys().hasAny(['auth', 'pinsConfigured'])
        && request.resource.data.keys().hasAll(['auth', 'ownerUid', 'members'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members[request.auth.uid] == 'office'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['auth', 'ownerUid', 'members', 'updatedAt'])
        && request.resource.data.members.diff(membersMap()).affectedKeys()
          .hasOnly([request.auth.uid])
        && (
          !resource.data.keys().hasAny(['ownerUid'])
          || resource.data.get('ownerUid', '') == ''
          || resource.data.ownerUid == request.auth.uid
        );
    }

    // ---- #162 / #215: per-log documents and review lock -----------------------
    // Each shared log lives at `shops/{shopId}/logs/{logId}` with `id == logId`,
    // so duplicate IDs cannot exist in the subcollection and each write is
    // checked directly on that single log document without array-pairing limits.
    //
    // Once a log is reviewed (reviewedAt and reviewedBy non-blank, as isLogReviewed in
    // src/reviewQueue.ts) no writer may delete it or overwrite it. It may only be
    //   - corrected as storage.buildCorrection writes it: revision + 1, history =
    //     old history + one entry {revision, priorSnapshot (the stored log minus history /
    //     reuploads / retainUntil), changedAt, changedBy, reason, changes}, with id,
    //     createdAt, review stamp and re-upload records unchanged; or
    //   - re-sent at the same revision with nothing changed except a later retainUntil
    //     hold and/or appended re-upload records (mergeLogIntoSet / buildReupload).
    // An unreviewed log's hold date D (#221, #227) may not move earlier when it is edited,
    // and an unreviewed log may only be deleted once its 2-year hold is over in UTC-12.

    function nonBlank(v) {
      return v is string && v.trim().size() > 0;
    }

    function isReviewedLog(log) {
      return nonBlank(log.get('reviewedAt', null)) && nonBlank(log.get('reviewedBy', null));
    }

    // Correction as storage.buildCorrection writes it. `revision` = prior revision + 1.
    // (Any missing or mistyped field is an evaluation error, which denies the write.)
    function isReviewedCorrection(prev, next, revision) {
      let prior = prev.get('history', []);
      let entry = next.history[prior.size()];
      return !prev.diff(next).affectedKeys().hasAny(['id', 'createdAt', 'reviewedAt', 'reviewedBy', 'reuploads'])
        // The 2-year hold only moves later (src/retention.ts); YYYY-MM-DD compares as text.
        && next.get('retainUntil', '') >= prev.get('retainUntil', '')
        && next.history == prior.concat([entry])
        && entry.revision == revision
        && entry.changedAt.trim().size() > 0
        && entry.changedBy.trim().size() > 0
        && entry.reason.trim().size() > 0
        && entry.changes.size() > 0
        && !entry.priorSnapshot.keys().hasAny(['history', 'reuploads', 'retainUntil'])
        && prev.diff(entry.priorSnapshot).affectedKeys().hasOnly(['history', 'reuploads', 'retainUntil']);
    }

    // Same revision: nothing changed but a later hold and/or appended re-upload records.
    function isReviewedResend(prev, next) {
      let before = prev.get('reuploads', []);
      return prev.diff(next).affectedKeys().hasOnly(['retainUntil', 'reuploads'])
        && next.get('retainUntil', '') >= prev.get('retainUntil', '')
        && (before.size() == 0 || next.reuploads[0:before.size()] == before);
    }

    // storage.buildCorrection: priorRevision = revision ?? history.length.
    function reviewedChangeOk(prev, next) {
      let revision = prev.get('revision', prev.get('history', []).size()) + 1;
      return next.get('revision', -1) == revision
        ? isReviewedCorrection(prev, next, revision)
        : isReviewedResend(prev, next);
    }

    // ---- #221 / #227: 2-year retention hold -----------------------------------
    // Hold date D = retainUntil (YYYY-MM-DD) when readable, else 2 years after the
    // later of dateUsed and createdAt's date (Feb 29 -> Mar 1, as src/retention.ts).
    // createdAt's date counts as one day later, since a device ahead of UTC may
    // already be on the next day. D runs to the end of D in UTC-12, so removal
    // needs request.time >= (D + 1 day) 12:00 UTC. No readable date -> held.
    function isYmd(v) {
      return v is string && v.trim().matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
    }

    function ymdInt(v) {
      return int(v[0:4]) * 10000 + int(v[5:7]) * 100 + int(v[8:10]);
    }

    function isCreatedAt(v) {
      return v is string && v.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T.*');
    }

    function holdOver(c) {
      return releasedAfter(holdUntil(c));
    }

    function holdUntil(c) {
      return isYmd(c.get('retainUntil', null))
        ? ymdInt(c.retainUntil.trim())
        : fallbackUntil(c.get('dateUsed', null), c.get('createdAt', null));
    }

    // Start = later of dateUsed and createdAt's date + 1 day; none readable -> held (99999999).
    function fallbackUntil(du, ca) {
      return isYmd(du)
        ? addTwoYears(isCreatedAt(ca) ? laterInt(ymdInt(du.trim()), ymdInt(ca) + 1) : ymdInt(du.trim()))
        : (isCreatedAt(ca) ? addTwoYears(ymdInt(ca) + 1) : 99999999);
    }

    function laterInt(a, b) {
      return a > b ? a : b;
    }

    function addTwoYears(start) {
      return start % 10000 == 229 ? start + 20072 : start + 20000;
    }

    // #227: an edit to an unreviewed log may not move its hold date D earlier (which
    // would let a second write remove it). Fast path when retainUntil, dateUsed and
    // createdAt are untouched; otherwise next needs a readable retainUntil >= prev's hold
    // (as stampRetainUntil writes when dateUsed moves earlier), or, when neither copy has
    // retainUntil, a fallback hold >= prev's.
    function unreviewedEditOk(prev, next) {
      return prev.id == next.id && (
        !prev.diff(next).affectedKeys().hasAny(['retainUntil', 'dateUsed', 'createdAt'])
        || (isYmd(next.get('retainUntil', null)) && ymdInt(next.retainUntil.trim()) >= holdUntil(prev))
        || (!('retainUntil' in prev) && !('retainUntil' in next) && fallbackUntil(next.get('dateUsed', null), next.get('createdAt', null)) >= fallbackUntil(prev.get('dateUsed', null), prev.get('createdAt', null)))
      );
    }

    // Hold date D runs to the end of D in UTC-12: released once request.time is at or
    // after (D + 1 day) 12:00 UTC, i.e. once the UTC date 36 hours earlier is >= D.
    function releasedAfter(d) {
      return limitInt(request.time - duration.value(36, 'h')) >= d;
    }

    function limitInt(t) {
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    // ---- #215: legacy `shops/{shopId}.logs` array migration -------------------
    // New and migrated shop docs carry `logs: []` (or no `logs` field) and store
    // every log at `shops/{shopId}/logs/{logId}`. For existing shop docs that still
    // carry a legacy `logs` array:
    //   - `create` on `shops/{shopId}/logs/{logId}` may not plant a forged copy for
    //     an ID that is still in the legacy array.
    //   - `update` on `shops/{shopId}` may only leave `logs` untouched or drain up
    //     to 8 legacy entries per write once each removed entry (or its deduplicated
    //     winner) has been written to `shops/{shopId}/logs/{logId}` (or its unreviewed
    //     2-year hold is over).

    function legacyHitOk(c, allowUnreviewed) {
      return allowUnreviewed && !isReviewedLog(c);
    }

    function legacyFullOctetOk(legacy, b, id, allowUnreviewed) {
      return (legacy[b].id != id || legacyHitOk(legacy[b], allowUnreviewed))
        && (legacy[b + 1].id != id || legacyHitOk(legacy[b + 1], allowUnreviewed))
        && (legacy[b + 2].id != id || legacyHitOk(legacy[b + 2], allowUnreviewed))
        && (legacy[b + 3].id != id || legacyHitOk(legacy[b + 3], allowUnreviewed))
        && (legacy[b + 4].id != id || legacyHitOk(legacy[b + 4], allowUnreviewed))
        && (legacy[b + 5].id != id || legacyHitOk(legacy[b + 5], allowUnreviewed))
        && (legacy[b + 6].id != id || legacyHitOk(legacy[b + 6], allowUnreviewed))
        && (legacy[b + 7].id != id || legacyHitOk(legacy[b + 7], allowUnreviewed));
    }

    function legacyPartialOctetOk(legacy, n, b, id, allowUnreviewed) {
      return (legacy[b].id != id || legacyHitOk(legacy[b], allowUnreviewed))
        && (n <= b + 1 || legacy[b + 1].id != id || legacyHitOk(legacy[b + 1], allowUnreviewed))
        && (n <= b + 2 || legacy[b + 2].id != id || legacyHitOk(legacy[b + 2], allowUnreviewed))
        && (n <= b + 3 || legacy[b + 3].id != id || legacyHitOk(legacy[b + 3], allowUnreviewed))
        && (n <= b + 4 || legacy[b + 4].id != id || legacyHitOk(legacy[b + 4], allowUnreviewed))
        && (n <= b + 5 || legacy[b + 5].id != id || legacyHitOk(legacy[b + 5], allowUnreviewed))
        && (n <= b + 6 || legacy[b + 6].id != id || legacyHitOk(legacy[b + 6], allowUnreviewed));
    }

    function legacyOctetOk(legacy, n, b, id, allowUnreviewed) {
      return n > b + 7
        ? legacyFullOctetOk(legacy, b, id, allowUnreviewed)
        : legacyPartialOctetOk(legacy, n, b, id, allowUnreviewed);
    }

    function legacyChunk48Ok(legacy, n, b, id, allowUnreviewed) {
      return (n <= b || legacyOctetOk(legacy, n, b, id, allowUnreviewed))
        && (n <= b + 8 || legacyOctetOk(legacy, n, b + 8, id, allowUnreviewed))
        && (n <= b + 16 || legacyOctetOk(legacy, n, b + 16, id, allowUnreviewed))
        && (n <= b + 24 || legacyOctetOk(legacy, n, b + 24, id, allowUnreviewed))
        && (n <= b + 32 || legacyOctetOk(legacy, n, b + 32, id, allowUnreviewed))
        && (n <= b + 40 || legacyOctetOk(legacy, n, b + 40, id, allowUnreviewed));
    }

    function legacyAllSlotsOk(legacy, id, allowUnreviewed) {
      let n = legacy.size();
      return n <= 48 && legacyChunk48Ok(legacy, n, 0, id, allowUnreviewed);
    }

    function legacyScannedTailOk(shopId, shopSnap, legacy, id, allowUnreviewed) {
      let n = legacy.size();
      let scanPath = /databases/$(database)/documents/shops/$(shopId)/legacyScan/cursor;
      let scanData = exists(scanPath) ? get(scanPath).data : {};
      let cursor = scanData.get('cursor', null);
      return cursor is int
        && cursor >= n
        && scanData.get('logId', null) == id
        && scanData.get('shopUpdatedAt', null) == shopSnap.data.get('updatedAt', null)
        && (allowUnreviewed || scanData.get('allowUnreviewed', false) == false);
    }

    function legacyCreateOk(shopId, shopSnap, logId) {
      let legacy = shopSnap.data.get('logs', []);
      let inLegacy = request.resource.data in legacy;
      return legacy.size() == 0
        || (inLegacy && isReviewedLog(request.resource.data))
        || (
          legacy.size() <= 48
          ? legacyAllSlotsOk(legacy, logId, inLegacy)
          : legacyScannedTailOk(shopId, shopSnap, legacy, logId, inLegacy)
        );
    }

    function legacyScanStepWriteOk(shopId) {
      let snap = get(/databases/$(database)/documents/shops/$(shopId));
      let legacy = snap != null ? snap.data.get('logs', []) : [];
      let n = legacy.size();
      let start = request.resource.data.get('start', null);
      let nextCursor = request.resource.data.get('cursor', null);
      let scanId = request.resource.data.get('logId', null);
      let scanAllow = request.resource.data.get('allowUnreviewed', false);
      let shopUpdatedAt = request.resource.data.get('shopUpdatedAt', null);
      return snap != null
        && isMemberData(snap.data)
        && request.resource.data.keys().hasOnly(['logId', 'allowUnreviewed', 'start', 'cursor', 'shopUpdatedAt'])
        && scanId is string
        && scanAllow is bool
        && shopUpdatedAt is string
        && shopUpdatedAt == snap.data.get('updatedAt', null)
        && start is int
        && nextCursor is int
        && start >= 0
        && start < n
        && nextCursor == start + 48
        && legacyChunk48Ok(legacy, n, start, scanId, scanAllow);
    }

    function canCreateLog(shopId, logId) {
      let snap = get(/databases/$(database)/documents/shops/$(shopId));
      return snap != null
        && isMemberData(snap.data)
        && request.resource.data.id is string
        && request.resource.data.id == logId
        && legacyCreateOk(shopId, snap, logId);
    }

    function legacyDstOk(shopId, c) {
      let snap = getAfter(/databases/$(database)/documents/shops/$(shopId)/logs/$(c.id));
      return snap != null
        && snap.data.id == c.id
        && (!isReviewedLog(c) || snap.data == c);
    }

    function legacyLogMigrated(shopId, c) {
      return legacyDstOk(shopId, c) || (!isReviewedLog(c) && holdOver(c));
    }

    function legacyMigrationOk(shopId, before, after) {
      let removed = before.removeAll(after);
      let n = removed.size();
      return after.size() < before.size()
        && after.removeAll(before).size() == 0
        && n <= 8
        && (n <= 0 || legacyLogMigrated(shopId, removed[0]))
        && (n <= 1 || legacyLogMigrated(shopId, removed[1]))
        && (n <= 2 || legacyLogMigrated(shopId, removed[2]))
        && (n <= 3 || legacyLogMigrated(shopId, removed[3]))
        && (n <= 4 || legacyLogMigrated(shopId, removed[4]))
        && (n <= 5 || legacyLogMigrated(shopId, removed[5]))
        && (n <= 6 || legacyLogMigrated(shopId, removed[6]))
        && (n <= 7 || legacyLogMigrated(shopId, removed[7]));
    }

    function shopLogsFieldOk(shopId) {
      let before = resource.data.get('logs', []);
      let after = request.resource.data.get('logs', []);
      return after == before || legacyMigrationOk(shopId, before, after);
    }

    match /shops/{shopId} {
      // First-office create: creator must be signed in and set themselves as owner + office.
      // Logs live in `shops/{shopId}/logs/{logId}`; `logs` on the shop doc must be [] or omitted.
      allow create: if signedIn()
        && isValidShopId(shopId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'version', 'updatedAt', 'catalog', 'people', 'settings',
          'auth', 'ownerUid', 'members'
        ])
        && request.resource.data.get('logs', []) == []
        && request.resource.data.members[request.auth.uid] == 'office';

      // Authenticated get only (no public / unauthenticated read). List denied.
      allow get: if signedIn() && isValidShopId(shopId);
      allow list: if false;

      allow update: if signedIn()
        && isValidShopId(shopId)
        && shopLogsFieldOk(shopId)
        && (
          // Office/owner: full document updates (PIN change, migrate, etc.).
          (isOffice() && ownerUidUnchanged() && pinsStayHidden())
          // Tech: may update shop data (e.g. updatedAt, legacy logs drain) but not auth, ownerUid, or members.
          || (isTech() && ownerUidUnchanged() && authUnchanged() && membersUnchanged() && pinsConfiguredUnchanged() && pinsStayHidden())
          // After client PIN verify: add this uid to members (optional legacy owner claim).
          || isJoinSelfUpdate()
          // Pre-#3 shops with no auth hashes yet.
          || isLegacyPinBootstrap()
        );

      allow delete: if false;

      match /legacyScan/cursor {
        allow write: if signedIn()
          && isValidShopId(shopId)
          && (
            request.resource == null
              ? isShopMember(shopId)
              : (
                (
                  resource == null || request.resource.data.get('start', null) == 0
                    ? request.resource.data.get('start', null) == 0
                    : (
                      resource.data.get('cursor', null) == request.resource.data.get('start', null)
                      && resource.data.get('logId', null) == request.resource.data.get('logId', null)
                      && resource.data.get('allowUnreviewed', false) == request.resource.data.get('allowUnreviewed', false)
                      && resource.data.get('shopUpdatedAt', null) == request.resource.data.get('shopUpdatedAt', null)
                    )
                )
                && legacyScanStepWriteOk(shopId)
              )
          );
      }

      match /logs/{logId} {
        // Signed-in callers who know `shopId` may read logs (consistent with `shops/{shopId}` get).
        allow get, list: if signedIn() && isValidShopId(shopId);

        allow create: if signedIn()
          && isValidShopId(shopId)
          && isValidShopId(logId)
          && canCreateLog(shopId, logId);

        allow update: if signedIn()
          && isValidShopId(shopId)
          && isValidShopId(logId)
          && isShopMember(shopId)
          && resource.data.id == logId
          && request.resource.data.id == logId
          && (
            isReviewedLog(resource.data)
              ? reviewedChangeOk(resource.data, request.resource.data)
              : unreviewedEditOk(resource.data, request.resource.data)
          );

        allow delete: if signedIn()
          && isValidShopId(shopId)
          && isValidShopId(logId)
          && isShopMember(shopId)
          && !isReviewedLog(resource.data)
          && holdOver(resource.data);
      }
    }

    // Everything else stays denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
