rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // #5: Firebase Anonymous Auth + shop membership.
    // Unauthenticated strangers with a guessed shopId are denied (closes open IDOR).
    // Signed-in get is allowed so join/unlock can client-verify PIN hashes, then
    // write membership via join-self update. PIN hashes remain readable to any
    // authenticated caller who knows shopId on legacy docs. cf2: the shop-server
    // functions move hashes into shopSecrets/ (denied below) and leave only
    // pinsConfigured on the shop doc. localStorage session is UI-only; rules enforce membership
    // for writes after create/join.

    function signedIn() {
      return request.auth != null;
    }

    function isValidShopId(id) {
      return id.size() > 0
        && id.size() <= 1500
        && id != '.'
        && id != '..'
        && !id.matches('.*[/].*')
        && !id.matches('__.*__');
    }

    function membersMap() {
      return resource.data.get('members', {});
    }

    function requestMembers() {
      return request.resource.data.get('members', {});
    }

    function memberRole() {
      return request.auth.uid in membersMap()
        ? membersMap()[request.auth.uid]
        : null;
    }

    function isOwner() {
      return signedIn()
        && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    function isOffice() {
      return isOwner() || memberRole() == 'office';
    }

    function isTech() {
      return memberRole() == 'tech';
    }

    function isMember() {
      return isOffice() || isTech();
    }

    function ownerUidUnchanged() {
      return request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '');
    }

    function authUnchanged() {
      return request.resource.data.get('auth', null) == resource.data.get('auth', null);
    }

    function pinsConfiguredUnchanged() {
      return request.resource.data.get('pinsConfigured', null) == resource.data.get('pinsConfigured', null);
    }

    // cf2: once the shop server holds the PIN hashes, no client write may put
    // `auth` back on the readable doc or clear `pinsConfigured`.
    function pinsStayHidden() {
      return resource.data.get('pinsConfigured', false) != true
        || (
          request.resource.data.get('pinsConfigured', false) == true
          && !request.resource.data.keys().hasAny(['auth'])
        );
    }

    function membersUnchanged() {
      return requestMembers() == membersMap();
    }

    // Join / unlock after client PIN verify: only members[+optional ownerUid] and updatedAt change.
    function isJoinSelfUpdate() {
      return signedIn()
        && request.resource.data.members[request.auth.uid] in ['office', 'tech']
        && request.resource.data.members.diff(membersMap()).affectedKeys().hasOnly([request.auth.uid])
        && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'updatedAt'])
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'updatedAt', 'ownerUid'])
            && resource.data.get('ownerUid', '') == ''
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.members[request.auth.uid] == 'office'
          )
        );
    }

    // Pre-#3 / no-auth shops: first office device may set auth + claim ownership.
    // cf2: a shop whose hashes moved to the shop server (pinsConfigured) is not "no-auth".
    // Diff limited to bootstrap fields so other shop data cannot be overwritten.
    function isLegacyPinBootstrap() {
      return signedIn()
        && !resource.data.keys().hasAny(['auth', 'pinsConfigured'])
        && request.resource.data.keys().hasAll(['auth', 'ownerUid', 'members'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members[request.auth.uid] == 'office'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['auth', 'ownerUid', 'members', 'updatedAt'])
        && request.resource.data.members.diff(membersMap()).affectedKeys()
          .hasOnly([request.auth.uid])
        && (
          !resource.data.keys().hasAny(['ownerUid'])
          || resource.data.get('ownerUid', '') == ''
          || resource.data.ownerUid == request.auth.uid
        );
    }


    // ---- #162: review lock on shared logs -------------------------------------
    // Logs live in the shop doc's `logs` array. The client (RemoteShopStore.putShop)
    // rewrites the whole doc; logOutbox / mergeLogIntoSet replaces a log in place or
    // prepends a new one, and never removes one. Rules can't loop, so a write is checked
    // on the logs it changed: `changed` = old logs not found unchanged in the new array,
    // `added` = new logs not found unchanged in the old one. Replacements keep their
    // place and new logs go to the front, so changed[i] pairs with
    // added[added.size() - changed.size() + i].
    //
    // Once a log is reviewed (reviewedAt and reviewedBy non-blank, as isLogReviewed in
    // src/reviewQueue.ts) no writer may delete it or overwrite it. It may only be
    //   - corrected exactly as storage.buildCorrection writes it: revision + 1, history =
    //     old history + one entry {revision, priorSnapshot (the stored log minus history /
    //     reuploads / retainUntil), changedAt, changedBy, reason, changes}, with id,
    //     createdAt, review stamp and re-upload records unchanged; or
    //   - re-sent at the same revision with nothing changed except a later retainUntil
    //     hold and/or appended re-upload records (mergeLogIntoSet / buildReupload).
    // Unreviewed logs are not restricted (as before). Adding a log the shop doesn't have
    // (including a re-upload of a missing log) is not restricted either.
    //
    // A request may evaluate at most 1000 expressions, so these checks are kept short.

    function nonBlank(v) {
      return v is string && v.trim().size() > 0;
    }

    function isReviewedLog(log) {
      return nonBlank(log.get('reviewedAt', null)) && nonBlank(log.get('reviewedBy', null));
    }

    // Correction as storage.buildCorrection writes it. `revision` = prior revision + 1.
    // (Any missing or mistyped field is an evaluation error, which denies the write.)
    function isReviewedCorrection(prev, next, revision) {
      let prior = prev.get('history', []);
      let entry = next.history[prior.size()];
      return !prev.diff(next).affectedKeys().hasAny(['id', 'createdAt', 'reviewedAt', 'reviewedBy', 'reuploads'])
        // The 2-year hold only moves later (src/retention.ts); YYYY-MM-DD compares as text.
        && next.get('retainUntil', '') >= prev.get('retainUntil', '')
        && next.history == prior.concat([entry])
        && entry.revision == revision
        && entry.changedAt.trim().size() > 0
        && entry.changedBy.trim().size() > 0
        && entry.reason.trim().size() > 0
        && entry.changes.size() > 0
        && !entry.priorSnapshot.keys().hasAny(['history', 'reuploads', 'retainUntil'])
        && prev.diff(entry.priorSnapshot).affectedKeys().hasOnly(['history', 'reuploads', 'retainUntil']);
    }

    // Same revision: nothing changed but a later hold and/or appended re-upload records.
    function isReviewedResend(prev, next) {
      let before = prev.get('reuploads', []);
      return prev.diff(next).affectedKeys().hasOnly(['retainUntil', 'reuploads'])
        && next.get('retainUntil', '') >= prev.get('retainUntil', '')
        && (before.size() == 0 || next.reuploads[0:before.size()] == before);
    }

    // storage.buildCorrection: priorRevision = revision ?? history.length.
    function reviewedChangeOk(prev, next) {
      let revision = prev.get('revision', prev.get('history', []).size()) + 1;
      return next.get('revision', -1) == revision
        ? isReviewedCorrection(prev, next, revision)
        : isReviewedResend(prev, next);
    }

    // changed[i]: unreviewed → no limit; reviewed → its paired replacement must pass.
    function changedLogOk(changed, added, i) {
      return !('reviewedAt' in changed[i])
        || !isReviewedLog(changed[i])
        || reviewedChangeOk(changed[i], added[request.resource.data.logs.size() - resource.data.logs.size() + i]);
    }

    // Up to 40 changed logs per write (unchanged and new logs don't count; a sync write
    // changes one log, an outbox flush a few), checked in blocks of 8 so unused slots
    // cost one comparison per block. The 1000-expression limit is reached first in
    // practice: about 35 changed unreviewed logs, or 3 corrections / 5 re-sends of
    // reviewed logs (a correction costs about as much as 12 unreviewed edits), in one
    // write. A bigger write is denied (fails closed).
    function changedLogs0to7(changed, added, n) {
      return (n <= 0 || changedLogOk(changed, added, 0))
        && (n <= 1 || changedLogOk(changed, added, 1))
        && (n <= 2 || changedLogOk(changed, added, 2))
        && (n <= 3 || changedLogOk(changed, added, 3))
        && (n <= 4 || changedLogOk(changed, added, 4))
        && (n <= 5 || changedLogOk(changed, added, 5))
        && (n <= 6 || changedLogOk(changed, added, 6))
        && (n <= 7 || changedLogOk(changed, added, 7));
    }

    function changedLogs8to15(changed, added, n) {
      return (n <= 8 || changedLogOk(changed, added, 8))
        && (n <= 9 || changedLogOk(changed, added, 9))
        && (n <= 10 || changedLogOk(changed, added, 10))
        && (n <= 11 || changedLogOk(changed, added, 11))
        && (n <= 12 || changedLogOk(changed, added, 12))
        && (n <= 13 || changedLogOk(changed, added, 13))
        && (n <= 14 || changedLogOk(changed, added, 14))
        && (n <= 15 || changedLogOk(changed, added, 15));
    }

    function changedLogs16to23(changed, added, n) {
      return (n <= 16 || changedLogOk(changed, added, 16))
        && (n <= 17 || changedLogOk(changed, added, 17))
        && (n <= 18 || changedLogOk(changed, added, 18))
        && (n <= 19 || changedLogOk(changed, added, 19))
        && (n <= 20 || changedLogOk(changed, added, 20))
        && (n <= 21 || changedLogOk(changed, added, 21))
        && (n <= 22 || changedLogOk(changed, added, 22))
        && (n <= 23 || changedLogOk(changed, added, 23));
    }

    function changedLogs24to31(changed, added, n) {
      return (n <= 24 || changedLogOk(changed, added, 24))
        && (n <= 25 || changedLogOk(changed, added, 25))
        && (n <= 26 || changedLogOk(changed, added, 26))
        && (n <= 27 || changedLogOk(changed, added, 27))
        && (n <= 28 || changedLogOk(changed, added, 28))
        && (n <= 29 || changedLogOk(changed, added, 29))
        && (n <= 30 || changedLogOk(changed, added, 30))
        && (n <= 31 || changedLogOk(changed, added, 31));
    }

    function changedLogs32to39(changed, added, n) {
      return (n <= 32 || changedLogOk(changed, added, 32))
        && (n <= 33 || changedLogOk(changed, added, 33))
        && (n <= 34 || changedLogOk(changed, added, 34))
        && (n <= 35 || changedLogOk(changed, added, 35))
        && (n <= 36 || changedLogOk(changed, added, 36))
        && (n <= 37 || changedLogOk(changed, added, 37))
        && (n <= 38 || changedLogOk(changed, added, 38))
        && (n <= 39 || changedLogOk(changed, added, 39));
    }

    function changedLogsOk(changed, added) {
      let n = changed.size();
      return n <= 40
        && (n <= 0 || changedLogs0to7(changed, added, n))
        && (n <= 8 || changedLogs8to15(changed, added, n))
        && (n <= 16 || changedLogs16to23(changed, added, n))
        && (n <= 24 || changedLogs24to31(changed, added, n))
        && (n <= 32 || changedLogs32to39(changed, added, n));
    }

    // Fast path: the write leaves `logs` exactly as it was (membership, PIN changes).
    function reviewedLogsLocked() {
      return request.resource.data.logs == resource.data.logs
        || changedLogsOk(
          resource.data.logs.removeAll(request.resource.data.logs),
          request.resource.data.logs.removeAll(resource.data.logs)
        );
    }

    match /shops/{shopId} {
      // First-office create: creator must be signed in and set themselves as owner + office.
      allow create: if signedIn()
        && isValidShopId(shopId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'version', 'updatedAt', 'logs', 'catalog', 'people', 'settings',
          'auth', 'ownerUid', 'members'
        ])
        && request.resource.data.members[request.auth.uid] == 'office';

      // Authenticated get only (no public / unauthenticated read). List denied.
      allow get: if signedIn() && isValidShopId(shopId);
      allow list: if false;

      allow update: if signedIn()
        && isValidShopId(shopId)
        // #162: applies to every writer (office, tech, join, bootstrap).
        && reviewedLogsLocked()
        && (
          // Office/owner: full document updates (PIN change, migrate, etc.).
          (isOffice() && ownerUidUnchanged() && pinsStayHidden())
          // Tech: may update shop data but not auth, ownerUid, or members.
          || (isTech() && ownerUidUnchanged() && authUnchanged() && membersUnchanged() && pinsConfiguredUnchanged() && pinsStayHidden())
          // After client PIN verify: add this uid to members (optional legacy owner claim).
          || isJoinSelfUpdate()
          // Pre-#3 shops with no auth hashes yet.
          || isLegacyPinBootstrap()
        );

      allow delete: if false;
    }

    // Everything else stays denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
